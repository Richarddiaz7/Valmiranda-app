<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { font-family: sans-serif; text-align: center; background-color: #f0f0f0; padding: 20px; }
        .card { background: white; border-radius: 10px; padding: 15px; margin: 10px 0; border: 1px solid #ccc; cursor: pointer; }
    </style>
</head>
<body>
    <h1>🍏 Valmiranda POS</h1>
    <div class="card" onclick="enviar('Papa')">🛒 Papa</div>
    <div class="card" onclick="enviar('Cebolla')">🛒 Cebolla</div>
    <div class="card" onclick="enviar('Tomate')">🛒 Tomate</div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        function enviar(producto) {
            tg.sendData(producto);
            tg.close();
        }
    </script>
</body>
</html>
