<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valmiranda App</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body { font-family: sans-serif; background-color: var(--tg-theme-bg-color); color: var(--tg-theme-text-color); padding: 20px; text-align: center; }
        .card { background: var(--tg-theme-secondary-bg-color); border-radius: 12px; padding: 15px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; border: 1px solid #ddd; cursor: pointer; }
        button { background: #2ecc71; color: white; border: none; padding: 10px 15px; border-radius: 8px; font-weight: bold; pointer-events: none; }
    </style>
</head>
<body>
    <h1>🍏 Valmiranda POS</h1>
    <p>Toca un producto para pedirlo:</p>

    <div class="card" onclick="enviarAlChat('Papa')"><span>Papa</span><button>Pedir</button></div>
    <div class="card" onclick="enviarAlChat('Cebolla')"><span>Cebolla</span><button>Pedir</button></div>
    <div class="card" onclick="enviarAlChat('Tomate')"><span>Tomate</span><button>Pedir</button></div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();
        tg.ready();

        function enviarAlChat(producto) {
            // Esta función envía el texto directo al bot y cierra la app
            tg.sendData(producto);
            tg.close();
        }
    </script>
</body>
</html>
